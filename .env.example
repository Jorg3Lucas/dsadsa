# ==========================================
# 🤖 MIR4 Claim Bot — example environment file
# ==========================================
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
#
# `.env` is gitignored and must NEVER be committed (it holds the bot token).
# Every variable below is optional at the code level — when unset, the bot
# keeps its built-in fallback — but a production deployment should set them all.
# ==========================================


# ──────────────────────────────────────────
# 🔑 Core (required)
# ──────────────────────────────────────────

# Bot token from the Discord Developer Portal.
# Either TOKEN or DISCORD_TOKEN works (TOKEN wins if both are set).
TOKEN=your-bot-token
DISCORD_TOKEN=

# Application (client) ID — used by `node src/deploy-commands.cjs` to register
# the ranking slash commands.
CLIENT_ID=your-application-client-id

# Guild (server) ID the bot operates on. Required — boot fails without it.
DISCORD_SERVER_ID=your-guild-id


# ──────────────────────────────────────────
# 🚩 Feature flags
# ──────────────────────────────────────────

# Ranking / registration system (scraper, sync, registration panels, clan roles,
# slash commands, claim-channel permissions). Default: false.
RANKING_ENABLED=false

# Claim website (browser claim site + JSON API). Default: false.
WEB_ENABLED=false


# ──────────────────────────────────────────
# 🌐 Claim website (only used when WEB_ENABLED=true)
# ──────────────────────────────────────────

# Interface and port the web server listens on (defaults: 0.0.0.0 / 3000).
WEB_HOST=0.0.0.0
WEB_PORT=3000

# Set to true when serving behind an HTTPS reverse proxy (enables Secure cookies).
WEB_HTTPS=false


# ──────────────────────────────────────────
# 🎭 Roles (Discord IDs)
# ──────────────────────────────────────────

# Membership role the bot manages (granted by ranking validation, used for
# claim-channel permissions). The bot NEVER creates roles — create it manually.
MEMBER_ROLE_ID=your-member-role-id

# Staff role for the ticket system — added to every ticket, allowed to
# manage/close. Leave empty to rely on the Manage Messages permission only.
STAFF_ROLE_ID=

# Elder role — may write in tower-rules / announcements / allied-list.
ELDER_ROLE_ID=your-elder-role-id


# ──────────────────────────────────────────
# 📁 Categories & channels (Discord IDs)
# ──────────────────────────────────────────

# Category where ticket channels are created.
TICKET_CATEGORY_ID=your-ticket-category-id

# The two claim categories the bot recreates on boot.
CLAIM_CATEGORY_SP_SUMMONS_ID=your-sp-summons-category-id
CLAIM_CATEGORY_MS_ID=your-ms-category-id

# Channel that receives the world-boss arena @everyone alert.
WORLD_BOSS_ARENA_CHANNEL_ID=your-world-boss-channel-id


# ──────────────────────────────────────────
# 🏆 Ranking / registration (only used when RANKING_ENABLED=true)
# ──────────────────────────────────────────

# Roles allowed to approve/reject member registrations, comma-separated.
APPROVER_ROLE_IDS=111111111111111111,222222222222222222

# Only this user can run high-risk commands (super admin).
SUPER_ADMIN_USER_ID=your-super-admin-user-id

# Fallback channel used for registration DMs (/listunregistered).
REGISTRATION_CHANNEL_ID=your-registration-channel-id
